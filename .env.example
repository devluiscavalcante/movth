# Project
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=movth
POSTGRES_PASSWORD=movth_password
POSTGRES_DB=movth
DATABASE_URL=postgresql://movth:movth_password@postgres:5432/movth?schema=public
SHADOW_DATABASE_URL=postgresql://movth:movth_password@postgres:5432/movth_shadow?schema=public

# Redis
REDIS_URL=redis://redis:6379

# API
API_HOST=0.0.0.0
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-a-long-random-pepper
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

# Web
WEB_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://backend:4000

# AWS media storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=movth-dev-media
CLOUDFRONT_DOMAIN=https://cdn.example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Worker / transcoding
TRANSCODE_QUEUE_NAME=transcode
FFMPEG_THREADS=2
TRANSCODE_WORKDIR=/tmp/movth-transcode
